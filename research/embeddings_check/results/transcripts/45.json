{
 "clip_id": 45,
 "model": "faster-whisper large-v3",
 "language": "ru",
 "duration": 170.74,
 "segments": [
  {
   "start": 0.0,
   "end": 0.66,
   "text": "Кем работаете?"
  },
  {
   "start": 1.04,
   "end": 1.86,
   "text": "Я безработная."
  },
  {
   "start": 2.72,
   "end": 3.5,
   "text": "Почему так?"
  },
  {
   "start": 3.86,
   "end": 4.3,
   "text": "Уволили."
  },
  {
   "start": 5.36,
   "end": 6.64,
   "text": "И у вас сейчас грустный настроение?"
  },
  {
   "start": 6.66,
   "end": 8.38,
   "text": "Это весь мой работодатель, это не увидит."
  },
  {
   "start": 8.64,
   "end": 10.14,
   "text": "Он увидит 100%. А за что уволили?"
  },
  {
   "start": 10.56,
   "end": 11.28,
   "text": "Плохо работала."
  },
  {
   "start": 12.06,
   "end": 13.54,
   "text": "Понятно. А кем мечтали быть в детстве?"
  },
  {
   "start": 14.84,
   "end": 19.16,
   "text": "Когда снимали видео, кем я мечтала быть в детстве, я сказала учителем."
  },
  {
   "start": 19.58,
   "end": 20.22,
   "text": "А кем вы стали?"
  },
  {
   "start": 20.68,
   "end": 23.44,
   "text": "Я художник, безработный художник."
  },
  {
   "start": 23.52,
   "end": 25.32,
   "text": "Если кому-то нужны картины, обращайтесь ко мне."
  },
  {
   "start": 25.52,
   "end": 27.22,
   "text": "Хотела быть художником, стала художником."
  },
  {
   "start": 27.54,
   "end": 28.28,
   "text": "Всегда рисовала."
  },
  {
   "start": 30.0,
   "end": 31.64,
   "text": "Можете прямо что-нибудь частное рисовать?"
  },
  {
   "start": 31.84,
   "end": 32.46,
   "text": "Я вам ручку дам."
  },
  {
   "start": 32.76,
   "end": 33.24,
   "text": "Ну, давайте."
  },
  {
   "start": 33.84,
   "end": 35.58,
   "text": "Нет, ну не ручку, я дам карандаш."
  },
  {
   "start": 35.6,
   "end": 36.4,
   "text": "Могу на воздухе."
  },
  {
   "start": 36.4,
   "end": 39.88,
   "text": "Нет, я дам карандаш и дам бакнотик."
  },
  {
   "start": 40.14,
   "end": 42.68,
   "text": "А вдруг я очень популярная, и вы сможете это здорово продать?"
  },
  {
   "start": 42.82,
   "end": 44.58,
   "text": "Ну, круто тогда. Наконец-то заработаю."
  },
  {
   "start": 45.24,
   "end": 48.0,
   "text": "Знаете, как Сальвадор, он расписывался на салфетках вот."
  },
  {
   "start": 49.3,
   "end": 50.18,
   "text": "Давайте попробуем?"
  },
  {
   "start": 50.5,
   "end": 51.58,
   "text": "Давайте я вам усы нарисую."
  },
  {
   "start": 52.04,
   "end": 52.66,
   "text": "У меня не есть."
  },
  {
   "start": 52.68,
   "end": 53.26,
   "text": "У вас уже есть."
  },
  {
   "start": 53.26,
   "end": 53.44,
   "text": "Да."
  },
  {
   "start": 53.88,
   "end": 55.9,
   "text": "Вы шарите за юмором, смотрю, тоже."
  },
  {
   "start": 55.98,
   "end": 57.1,
   "text": "Рисуем меня попробуем."
  },
  {
   "start": 57.26,
   "end": 57.78,
   "text": "Или..."
  },
  {
   "start": 57.78,
   "end": 58.76,
   "text": "Или говорящую улицу."
  },
  {
   "start": 59.2,
   "end": 59.98,
   "text": "Говорящую улицу."
  },
  {
   "start": 60.16,
   "end": 61.28,
   "text": "У вас какая любимая страница?"
  },
  {
   "start": 62.02,
   "end": 62.86,
   "text": "Я там первая самая."
  },
  {
   "start": 62.98,
   "end": 64.1,
   "text": "Все сначала начинаю."
  },
  {
   "start": 64.2,
   "end": 65.32,
   "text": "Сколько времени надо на это?"
  },
  {
   "start": 65.32,
   "end": 66.66,
   "text": "Давай пять минут дадим, типа."
  },
  {
   "start": 66.7,
   "end": 67.7,
   "text": "Часов шестнадцать обычно."
  },
  {
   "start": 68.32,
   "end": 69.5,
   "text": "Хотите натурщиком прийти?"
  },
  {
   "start": 69.74,
   "end": 70.7,
   "text": "Конечно, я..."
  },
  {
   "start": 70.7,
   "end": 71.18,
   "text": "За деньги."
  },
  {
   "start": 71.38,
   "end": 72.14,
   "text": "За деньги, реально."
  },
  {
   "start": 72.64,
   "end": 73.24,
   "text": "Кристина, смотрите."
  },
  {
   "start": 73.44,
   "end": 75.82,
   "text": "Мы рисуем сейчас говорящую улицу."
  },
  {
   "start": 75.9,
   "end": 77.62,
   "text": "Я же уволенный художник, я плохо рисую."
  },
  {
   "start": 77.96,
   "end": 79.36,
   "text": "Мы их распроверим."
  },
  {
   "start": 79.84,
   "end": 82.08,
   "text": "Мы оценят люди, которые будут смотреть это видео."
  },
  {
   "start": 82.34,
   "end": 82.74,
   "text": "Пошли."
  },
  {
   "start": 82.98,
   "end": 84.22,
   "text": "О, сейчас будет пушка."
  },
  {
   "start": 84.44,
   "end": 85.9,
   "text": "Кепка ваша не помещается в блокноте."
  },
  {
   "start": 85.92,
   "end": 87.04,
   "text": "Ну, можно без кепки там."
  },
  {
   "start": 87.32,
   "end": 87.84,
   "text": "А все уже."
  },
  {
   "start": 88.18,
   "end": 89.86,
   "text": "Вы не думаете, что хорошо получается?"
  },
  {
   "start": 90.0,
   "end": 90.7,
   "text": "Это вовсе не так."
  },
  {
   "start": 90.94,
   "end": 91.98,
   "text": "Лучше бы снимать."
  },
  {
   "start": 92.94,
   "end": 94.06,
   "text": "Там реально плохо."
  },
  {
   "start": 94.8,
   "end": 96.1,
   "text": "Но подбородок у вас красивый."
  },
  {
   "start": 97.1,
   "end": 98.58,
   "text": "Вы как молодой Лермонтов."
  },
  {
   "start": 99.18,
   "end": 100.38,
   "text": "Отношения-то как-то были у вас?"
  },
  {
   "start": 100.76,
   "end": 101.46,
   "text": "Какие-то были, да."
  },
  {
   "start": 101.74,
   "end": 102.78,
   "text": "Что не сложилось?"
  },
  {
   "start": 103.06,
   "end": 104.26,
   "text": "Ну, любви, получается, не было."
  },
  {
   "start": 104.44,
   "end": 105.56,
   "text": "Она появилась сразу."
  },
  {
   "start": 105.66,
   "end": 106.56,
   "text": "Ну, что, появилась как-то сразу?"
  },
  {
   "start": 108.48,
   "end": 109.86,
   "text": "Вдохновение, типа, в моменте просто."
  },
  {
   "start": 110.06,
   "end": 110.6,
   "text": "Потом уходит."
  },
  {
   "start": 110.9,
   "end": 112.6,
   "text": "Ну, как будто бы любовь-то не про вдохновение."
  },
  {
   "start": 113.0,
   "end": 113.96,
   "text": "Вдохновение-то выбор."
  },
  {
   "start": 114.52,
   "end": 117.28,
   "text": "Видимо, с какой-то стороны не было выбора."
  },
  {
   "start": 118.22,
   "end": 119.28,
   "text": "А что для тебя любовь реально?"
  },
  {
   "start": 119.28,
   "end": 119.92,
   "text": "Ну, быть..."
  },
  {
   "start": 120.0,
   "end": 120.96,
   "text": "Деятелем жизни другого."
  },
  {
   "start": 121.2,
   "end": 122.62,
   "text": "Это не любовь, это, наверное, отношения."
  },
  {
   "start": 123.4,
   "end": 124.4,
   "text": "Ну, любовь-то, конечно, хорошо."
  },
  {
   "start": 124.62,
   "end": 125.08,
   "text": "А что это?"
  },
  {
   "start": 125.22,
   "end": 125.8,
   "text": "Хер его знает."
  },
  {
   "start": 126.72,
   "end": 127.08,
   "text": "Непонятно."
  },
  {
   "start": 127.2,
   "end": 129.78,
   "text": "Что для вас важно в мужчине?"
  },
  {
   "start": 130.76,
   "end": 131.88,
   "text": "Чтобы человеком хорошим был."
  },
  {
   "start": 132.1,
   "end": 134.04,
   "text": "Четкие спрашивают, там, зарплаты, машины."
  },
  {
   "start": 134.26,
   "end": 135.44,
   "text": "Я как-то..."
  },
  {
   "start": 136.28,
   "end": 136.72,
   "text": "Не знаю."
  },
  {
   "start": 137.66,
   "end": 139.94,
   "text": "Ну, он должен хотя бы там работать."
  },
  {
   "start": 141.0,
   "end": 141.3,
   "text": "Нет."
  },
  {
   "start": 141.88,
   "end": 142.82,
   "text": "Я ж не работаю."
  },
  {
   "start": 144.52,
   "end": 146.32,
   "text": "Ты бы понял, как за счет..."
  },
  {
   "start": 146.32,
   "end": 147.0,
   "text": "Как будете жить?"
  },
  {
   "start": 147.64,
   "end": 148.44,
   "text": "Ну, хорошо."
  },
  {
   "start": 148.94,
   "end": 149.3,
   "text": "Припеваючи."
  },
  {
   "start": 149.3,
   "end": 150.3,
   "text": "Ну, давай."
  },
  {
   "start": 150.3,
   "end": 151.3,
   "text": "Видимо, в шалаше."
  },
  {
   "start": 151.3,
   "end": 152.3,
   "text": "Ха-ха."
  },
  {
   "start": 152.3,
   "end": 153.3,
   "text": "Хочешь оставим это?"
  },
  {
   "start": 153.3,
   "end": 154.3,
   "text": "Давай."
  },
  {
   "start": 154.3,
   "end": 155.3,
   "text": "Это зачем?"
  },
  {
   "start": 155.3,
   "end": 156.3,
   "text": "Посмотрим."
  },
  {
   "start": 156.3,
   "end": 157.3,
   "text": "Ну, реально же, а?"
  },
  {
   "start": 157.3,
   "end": 158.3,
   "text": "Ну, похож?"
  },
  {
   "start": 158.3,
   "end": 159.3,
   "text": "Нет."
  },
  {
   "start": 159.3,
   "end": 160.3,
   "text": "Да, похож."
  },
  {
   "start": 160.3,
   "end": 161.3,
   "text": "Смотри, если сниму, то..."
  },
  {
   "start": 161.3,
   "end": 162.3,
   "text": "Волосы просто."
  },
  {
   "start": 162.3,
   "end": 163.3,
   "text": "Ну, реально похож, да?"
  },
  {
   "start": 163.3,
   "end": 164.3,
   "text": "Как будто бы, да."
  },
  {
   "start": 164.3,
   "end": 165.3,
   "text": "Блин, класс."
  },
  {
   "start": 165.3,
   "end": 166.3,
   "text": "Это я отдаю вам на память."
  },
  {
   "start": 166.3,
   "end": 167.3,
   "text": "Не сожритесь."
  },
  {
   "start": 167.3,
   "end": 168.3,
   "text": "Ну, кулак ночи?"
  },
  {
   "start": 168.3,
   "end": 169.3,
   "text": "Да, Ира, и карандаш."
  },
  {
   "start": 169.3,
   "end": 170.3,
   "text": "Слава Богу, что это."
  },
  {
   "start": 170.3,
   "end": 171.3,
   "text": "Больше никто не увидит."
  }
 ]
}