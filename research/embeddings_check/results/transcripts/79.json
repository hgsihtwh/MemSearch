{
 "clip_id": 79,
 "model": "faster-whisper large-v3",
 "language": "ru",
 "duration": 76.44,
 "segments": [
  {
   "start": 0.0,
   "end": 2.88,
   "text": "Неожиданно у меня залетел рилс аж на 100 тысяч просмотров,"
  },
  {
   "start": 3.1,
   "end": 5.96,
   "text": "в котором я делюсь, что я не оставляю гостям в посуточной квартире"
  },
  {
   "start": 5.96,
   "end": 8.52,
   "text": "большие флаконы с шампунями и гелями для душа,"
  },
  {
   "start": 8.62,
   "end": 9.82,
   "text": "а оставляю маленькие пакетики."
  },
  {
   "start": 10.04,
   "end": 11.44,
   "text": "И с соображением безопасности."
  },
  {
   "start": 11.5,
   "end": 14.3,
   "text": "Я высказала свои опасения, что в эти флаконы"
  },
  {
   "start": 14.3,
   "end": 16.12,
   "text": "могли что-то сделать предыдущие гости."
  },
  {
   "start": 16.26,
   "end": 17.66,
   "text": "Некоторые комментаторы обвинили меня,"
  },
  {
   "start": 17.8,
   "end": 19.78,
   "text": "что я тревожница и вообще ненормальная,"
  },
  {
   "start": 20.02,
   "end": 20.82,
   "text": "которая выдумывает."
  },
  {
   "start": 21.16,
   "end": 23.76,
   "text": "И такого ничего гости никогда не делают."
  },
  {
   "start": 23.92,
   "end": 25.16,
   "text": "Но под постом пришли люди,"
  },
  {
   "start": 25.34,
   "end": 27.02,
   "text": "которые реально с этим сталкивались."
  },
  {
   "start": 27.02,
   "end": 28.54,
   "text": "Именно такой случай произошел"
  },
  {
   "start": 28.54,
   "end": 30.18,
   "text": "с мной в ориентованной квартире в Казани."
  },
  {
   "start": 30.58,
   "end": 31.64,
   "text": "Я помылась с шампунем,"
  },
  {
   "start": 31.94,
   "end": 33.8,
   "text": "какой-то красящей штукой типа синьки."
  },
  {
   "start": 34.5,
   "end": 36.24,
   "text": "И это был полный капец."
  },
  {
   "start": 36.8,
   "end": 39.2,
   "text": "Хозяйка квартиры тоже знатно была удивлена."
  },
  {
   "start": 40.02,
   "end": 40.96,
   "text": "Теперь я покупаю свое."
  },
  {
   "start": 41.42,
   "end": 42.98,
   "text": "Да, я так умылся до места"
  },
  {
   "start": 42.98,
   "end": 45.34,
   "text": "с амзолитом и вклеингом в бутылку с гелем для душа."
  },
  {
   "start": 45.86,
   "end": 47.32,
   "text": "В этой истории все обошлось."
  },
  {
   "start": 47.68,
   "end": 48.32,
   "text": "Реально кошмар."
  },
  {
   "start": 48.98,
   "end": 49.76,
   "text": "И напоследок."
  },
  {
   "start": 49.92,
   "end": 50.86,
   "text": "У меня есть знакомая,"
  },
  {
   "start": 51.12,
   "end": 52.48,
   "text": "которая смеясь рассказывала,"
  },
  {
   "start": 52.8,
   "end": 54.72,
   "text": "что сыт и плюет в шампуне"
  },
  {
   "start": 54.72,
   "end": 56.44,
   "text": "бальзамы в арендных квартирах."
  },
  {
   "start": 56.44,
   "end": 58.24,
   "text": "Ей просто нравится представлять,"
  },
  {
   "start": 58.24,
   "end": 60.02,
   "text": "как потом ничего не подозревающие люди"
  },
  {
   "start": 60.02,
   "end": 61.18,
   "text": "будут этим мыться."
  },
  {
   "start": 61.78,
   "end": 62.76,
   "text": "Никогда нечем не пользуюсь,"
  },
  {
   "start": 62.8,
   "end": 64.06,
   "text": "а свое вожу и покупаю."
  },
  {
   "start": 64.46,
   "end": 65.78,
   "text": "Вдруг она не одна такая ку-ку."
  },
  {
   "start": 66.12,
   "end": 68.42,
   "text": "А я уверена, что это не единичный случай."
  },
  {
   "start": 68.98,
   "end": 70.68,
   "text": "Ну что, я все еще псих?"
  },
  {
   "start": 71.02,
   "end": 72.22,
   "text": "Или я действительно заборщусь"
  },
  {
   "start": 72.22,
   "end": 73.3,
   "text": "о безопасности гостей"
  },
  {
   "start": 73.3,
   "end": 74.56,
   "text": "и оберегаю их от таких вот"
  },
  {
   "start": 74.56,
   "end": 76.14,
   "text": "пройдущих ненормальных арендаторов?"
  }
 ]
}