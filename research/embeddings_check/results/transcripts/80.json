{
 "clip_id": 80,
 "model": "faster-whisper large-v3",
 "language": "ru",
 "duration": 114.24,
 "segments": [
  {
   "start": 0.85,
   "end": 4.93,
   "text": "Возможно, я потом пожалею об этом, рился, но хочу поделиться."
  },
  {
   "start": 5.37,
   "end": 8.71,
   "text": "Я мама двух подростков, 16-15 лет, девочка и мальчик."
  },
  {
   "start": 8.93,
   "end": 13.75,
   "text": "И сегодня завершающий вечер нашего отпуска в одном из лучших отелей Бодрова."
  },
  {
   "start": 14.09,
   "end": 16.79,
   "text": "Какой вывод я сделала? Это последний наш совместный отпуск."
  },
  {
   "start": 17.47,
   "end": 19.59,
   "text": "Теперь я буду ездить одна либо с подругой,"
  },
  {
   "start": 19.85,
   "end": 23.59,
   "text": "потому что я устала на протяжении двух недель видеть недовольные лица."
  },
  {
   "start": 23.59,
   "end": 27.63,
   "text": "То вай-фай не тот, то вода соленая, то солнце жарит, то еще что-то."
  },
  {
   "start": 27.63,
   "end": 30.91,
   "text": "Любая моя просьба воспринимается как нарушение личных границ."
  },
  {
   "start": 31.11,
   "end": 35.19,
   "text": "И второй такой вывод и, наверное, совет для тех родителей,"
  },
  {
   "start": 35.33,
   "end": 41.29,
   "text": "которые вопреки всем своим трудностям пытаются и хотят показать мир своим детям."
  },
  {
   "start": 41.43,
   "end": 46.87,
   "text": "Ребят, не экономьте на себе, улучшите себе качество отдыха"
  },
  {
   "start": 46.87,
   "end": 51.23,
   "text": "и дайте детям возможность вырасти, сепарироваться, заработать,"
  },
  {
   "start": 51.23,
   "end": 53.71,
   "text": "поехать отдыхать самим в путешествии."
  },
  {
   "start": 53.87,
   "end": 56.85,
   "text": "А им это не надо, это надо нам."
  },
  {
   "start": 57.05,
   "end": 57.23,
   "text": "Вот."
  },
  {
   "start": 57.63,
   "end": 62.47,
   "text": "Не очень такое приятное, наверное, мнение, но это действительно так."
  },
  {
   "start": 62.63,
   "end": 65.19,
   "text": "Расстроена я, да, очень-очень."
  },
  {
   "start": 65.57,
   "end": 67.53,
   "text": "Даже сегодня паничку словила, честно."
  },
  {
   "start": 67.79,
   "end": 71.03,
   "text": "Вот, ну просто, когда ты хочешь дать своим детям лучшее,"
  },
  {
   "start": 71.85,
   "end": 73.93,
   "text": "ты напрягаешься, ты стараешься,"
  },
  {
   "start": 73.93,
   "end": 77.93,
   "text": "и ты видишь просто, что ты посягаешь на их личные границы."
  },
  {
   "start": 80.13,
   "end": 80.57,
   "text": "Саляви."
  },
  {
   "start": 81.73,
   "end": 85.37,
   "text": "У нас сегодня экзамен, как мы отвечаем мошенникам телефонным на вопросы глупые."
  },
  {
   "start": 85.71,
   "end": 87.17,
   "text": "Если они тебе звонят и говорят, здравствуйте,"
  },
  {
   "start": 87.29,
   "end": 87.61,
   "text": "у вас есть мошенник?"
  },
  {
   "start": 87.63,
   "end": 88.65,
   "text": "У вас есть баска к пенсии, что мы отвечаем?"
  },
  {
   "start": 88.89,
   "end": 89.41,
   "text": "Нету."
  },
  {
   "start": 89.57,
   "end": 90.25,
   "text": "Неверный ответ."
  },
  {
   "start": 92.09,
   "end": 92.63,
   "text": "Есть, да."
  },
  {
   "start": 92.81,
   "end": 93.57,
   "text": "Неверный ответ."
  },
  {
   "start": 94.47,
   "end": 95.19,
   "text": "А какой тогда?"
  },
  {
   "start": 95.45,
   "end": 96.53,
   "text": "Идите нахуй."
  },
  {
   "start": 96.63,
   "end": 97.07,
   "text": "Все верно."
  },
  {
   "start": 98.25,
   "end": 100.29,
   "text": "У вас есть надбавка к пенсии, что мы отвечаем?"
  },
  {
   "start": 101.83,
   "end": 102.57,
   "text": "Пошли вы нахуй."
  },
  {
   "start": 103.41,
   "end": 104.69,
   "text": "У вас есть банковская карточка?"
  },
  {
   "start": 104.75,
   "end": 105.83,
   "text": "У меня не только одна."
  },
  {
   "start": 105.83,
   "end": 106.99,
   "text": "Неверный, неверный ответ."
  },
  {
   "start": 107.01,
   "end": 107.67,
   "text": "Пошли нахуй."
  },
  {
   "start": 109.35,
   "end": 109.95,
   "text": "Кладия Петровна."
  },
  {
   "start": 109.97,
   "end": 110.25,
   "text": "Пошла."
  },
  {
   "start": 111.81,
   "end": 112.83,
   "text": "Пять, садитесь."
  },
  {
   "start": 113.27,
   "end": 114.09,
   "text": "Давайте зачетку."
  }
 ]
}