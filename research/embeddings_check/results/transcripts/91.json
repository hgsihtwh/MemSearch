 "segments": [
  {
   "start": 0.0,
   "end": 4.3,
   "text": "Друзья, у нас есть небольшой такой спор с Илюхой, произошел в офисе."
  },
  {
   "start": 4.34,
   "end": 7.8,
   "text": "Кто из нас круче пародирует звук вертолета?"
  },
  {
   "start": 9.0,
   "end": 16.48,
   "text": "Я говорю, что я, а Илюха почему-то, как ни странно, говорит, что он."
  },
  {
   "start": 16.7,
   "end": 17.32,
   "text": "Че, ты начнешь?"
  },
  {
   "start": 18.02,
   "end": 19.54,
   "text": "Ладно, все, слушаем."
  },
  {
   "start": 20.42,
   "end": 25.72,
   "text": "Полная тишина на площадке вертолетной."
  },
  {
   "start": 26.46,
   "end": 26.98,
   "text": "Блин."
  },
  {
   "start": 29.53,
   "end": 29.85,
   "text": "Мять."
  },
  {
   "start": 31.73,
   "end": 33.17,
   "text": "Это что я делаю?"
  },
  {
   "start": 35.75,
   "end": 36.09,
   "text": "Убери."
  },
  {
   "start": 39.31,
   "end": 67.74,
   "text": "Почему никуда не полетели?"
  },
  {
   "start": 68.86,
   "end": 69.7,
   "text": "Я не в форме."
  },
  {
   "start": 74.62,
   "end": 75.88,
   "text": "МС справа."
  },
  {
   "start": 76.96,
   "end": 78.52,
   "text": "Я че, на придурка похож?"
  },
  {
   "start": 80.38,
   "end": 81.1,
   "text": "Похож."
  },
  {
   "start": 81.2,
   "end": 81.62,
   "text": "Ну ладно."
  },
  {
   "start": 82.22,
   "end": 84.18,
   "text": "Конечно, похож."
  },
  {
   "start": 84.96,
   "end": 85.98,
   "text": "Ладно, тишина, пожалуйста."
  },
  {
   "start": 102.71,
   "end": 103.37,
   "text": "Чуть не упали."
  },
  {
   "start": 110.08,
   "end": 111.42,
   "text": "Вот пердеж на репетировании."
  },
  {
   "start": 111.58,
   "end": 112.36,
   "text": "Репет по сравнению."
  }
 ]
}